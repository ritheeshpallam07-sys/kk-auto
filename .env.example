# Kk_Auto Environment Variables

PORT=5000
NODE_ENV=development
JWT_SECRET=kk_auto_super_secret_jwt_key_2025

# Database Configuration:
# To connect to external PostgreSQL, provide standard connection string:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/kk_auto
# If left blank or commented out, Kk_Auto automatically utilizes embedded PGlite
# (real PostgreSQL engine in WASM/Node) with persistent storage in server/.data/pglite!
DATABASE_URL=

# Map Integrations (Optional future production keys):
# GOOGLE_MAPS_API_KEY=AIzaSy...
# MAPBOX_ACCESS_TOKEN=pk.eyJ1...
